---
import { social } from '@/settings'

const links = [
	social.email && { label: social.email, href: `mailto:${social.email}`, primary: true },
	social.linkedin && { label: 'LinkedIn', href: social.linkedin, primary: false },
	social.github && { label: 'GitHub', href: social.github, primary: false },
	social.scholar && { label: 'Scholar', href: social.scholar, primary: false },
].filter(Boolean) as { label: string; href: string; primary: boolean }[]
---

<section id="contact" class="py-24 text-center">
	<div class="mx-auto max-w-xl px-6">
		<p class="mb-3 font-mono text-xs uppercase tracking-widest text-accent dark:text-accent-dark">Contact</p>
		<h2 class="mb-4 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">Let's talk</h2>
		<p class="mb-8 text-[15px] leading-relaxed text-neutral-600 dark:text-neutral-400">
			Open to research collaboration, PhD-adjacent projects, or just a good conversation about ML and medical imaging. Reach out if you want to collaborate!
		</p>
		<div class="flex flex-wrap justify-center gap-3">
			{links.map((link) => (
				<a
					href={link.href}
					target={link.href.startsWith('mailto:') ? undefined : '_blank'}
					rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
					class:list={[
						"rounded-lg px-5 py-2.5 text-sm font-medium no-underline",
						link.primary
							? "bg-accent text-white dark:bg-accent-dark dark:text-neutral-950"
							: "border border-neutral-300 text-neutral-900 dark:border-neutral-700 dark:text-neutral-50",
					]}
				>
					{link.label}
				</a>
			))}
		</div>
	</div>
</section>
