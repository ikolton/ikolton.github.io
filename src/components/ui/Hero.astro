---
import { Image } from 'astro:assets'
import SocialIcons from './SocialIcons.astro'

const { fullName, title, secondaryTitle, institute, profilePicture } = Astro.props

const tags = [title, secondaryTitle, institute].filter(Boolean)
---

<div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
	<div class="max-w-xl">
		<p class="mb-3 font-mono text-xs uppercase tracking-widest text-emerald-600 dark:text-emerald-300">
			{tags.join(' · ')}
		</p>
		<h1 class="mb-4 text-3xl font-bold text-neutral-900 dark:text-neutral-50">
			{fullName}
		</h1>
		<div class="mt-6">
			<SocialIcons />
		</div>
	</div>
	<Image
		src={profilePicture}
		alt={fullName}
		class="hidden size-40 rounded-full object-cover lg:block"
	/>
</div>
