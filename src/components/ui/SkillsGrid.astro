---
import type { Skill } from '@/types/cv'

interface Props {
	skills: Skill[]
}

const { skills } = Astro.props
---

<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
	{skills.map((skill) => (
		<div>
			<p class="mb-1 text-sm font-semibold text-neutral-900 dark:text-neutral-50">{skill.title}</p>
			<p class="text-[13px] leading-relaxed text-neutral-500 dark:text-neutral-500">{skill.description}</p>
		</div>
	))}
</div>
