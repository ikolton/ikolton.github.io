---
interface Props {
	label: string
	items: { time: string; title: string; org: string; description?: string }[]
}

const { label, items } = Astro.props
---

<div class="min-w-70 flex-1">
	<p class="mb-4.5 text-[13px] font-semibold text-neutral-500 dark:text-neutral-500">{label}</p>
	<div class="flex flex-col">
		{items.map((item, index) => (
			<div class="flex gap-5">
				<div class="flex flex-none flex-col items-center pt-1.5">
					<span class="size-2.5 flex-none rounded-full bg-accent dark:bg-accent-dark"></span>
					{index !== items.length - 1 && <span class="mt-1 w-px flex-1 bg-neutral-200 dark:bg-neutral-800"></span>}
				</div>
				<div class="pb-9">
					<p class="mb-2 font-mono text-[11.5px] text-neutral-500 dark:text-neutral-500">{item.time}</p>
					<h3 class="text-[17px] font-semibold text-neutral-900 dark:text-neutral-50">{item.title}</h3>
					<p class="mb-2 mt-0.5 text-sm text-neutral-500 dark:text-neutral-500">{item.org}</p>
					{item.description && <p class="text-[14.5px] leading-relaxed text-neutral-600 dark:text-neutral-400">{item.description}</p>}
				</div>
			</div>
		))}
	</div>
</div>
