---
import type { Publication } from '@/types/cv'
import { highlightAuthor, trimExcerpt } from '@/lib/utils'
import { toBibtex } from '@/lib/bibtex'
import { presentations } from '@/data/cv'

interface Props {
	publications: Publication[]
	initialCount?: number
}

const { publications, initialCount = 2 } = Astro.props
const hiddenCount = Math.max(publications.length - initialCount, 0)

// Venues where a paper was presented, shown under its arXiv line
const presentedAt = (link?: string) =>
	presentations.filter((item) => link && item.paper === link).map((item) => `${item.type} at ${item.event}`)
---

<section id="publications" class="bg-neutral-50 py-20 dark:bg-neutral-900/40">
	<div class="mx-auto max-w-6xl px-6">
		<p class="mb-3 font-mono text-xs uppercase tracking-widest text-accent dark:text-accent-dark">Publications</p>
		<h2 class="mb-9 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">Recent work</h2>

		<div class="flex max-w-4xl flex-col gap-5">
			{publications.map((pub, index) => (
				<article
					class:list={["rounded-2xl border border-neutral-200 bg-white p-7 dark:border-neutral-800 dark:bg-neutral-950", index >= initialCount && "pub-extra hidden"]}
				>
					<h3 class="mb-2.5 text-lg font-bold leading-snug">
						<a href={pub.link} target="_blank" rel="noopener noreferrer" class="text-neutral-900 no-underline dark:text-neutral-50">
							{pub.title}
						</a>
					</h3>
					<p class="mb-1.5 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
						<span set:html={highlightAuthor(pub.authors)} />
					</p>
					<p class="mb-3 font-mono text-[11.5px] text-neutral-500 dark:text-neutral-500">
						{pub.journal} · {pub.time}
						{presentedAt(pub.link).map((label) => (
							<span class="text-accent dark:text-accent-dark"> · {label}</span>
						))}
					</p>
					<p class="text-[14.5px] leading-relaxed text-neutral-600 dark:text-neutral-400">{pub.abstract && trimExcerpt(pub.abstract)}</p>
					<div class="mt-3.5 flex flex-wrap gap-2.5">
						{pub.repo && (
							<a href={pub.repo} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-neutral-200 px-3.5 py-1.5 text-xs font-medium text-neutral-700 no-underline dark:border-neutral-800 dark:text-neutral-300">
								Code
							</a>
						)}
						<a href={pub.link} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-neutral-200 px-3.5 py-1.5 text-xs font-medium text-neutral-700 no-underline dark:border-neutral-800 dark:text-neutral-300">
							Read paper
						</a>
						<button type="button" class="bibtex-toggle rounded-lg border border-neutral-200 px-3.5 py-1.5 text-xs font-medium text-neutral-700 dark:border-neutral-800 dark:text-neutral-300" aria-expanded="false">
							BibTeX
						</button>
					</div>
					<pre class="bibtex hidden mt-3.5 overflow-x-auto rounded-lg border border-neutral-200 bg-neutral-50 p-4 font-mono text-[11.5px] leading-relaxed text-neutral-700 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300">{toBibtex(pub)}</pre>
				</article>
			))}
		</div>

		{hiddenCount > 0 && (
			<button
				id="publications-toggle"
				type="button"
				data-show-label={`Show ${hiddenCount} more ↓`}
				data-hide-label="Show less ↑"
				class="mt-6 font-mono text-sm font-semibold text-accent dark:text-accent-dark"
			>
				{`Show ${hiddenCount} more ↓`}
			</button>
		)}
	</div>
</section>

<script is:inline>
	(function () {
		function bind() {
			const btn = document.getElementById('publications-toggle');
			if (btn) {
				btn.addEventListener('click', () => {
					const extras = document.querySelectorAll('.pub-extra');
					const isCurrentlyHidden = extras[0]?.classList.contains('hidden');
					extras.forEach((el) => el.classList.toggle('hidden', !isCurrentlyHidden));
					btn.textContent = isCurrentlyHidden ? btn.dataset.hideLabel : btn.dataset.showLabel;
				});
			}

			// Opening a BibTeX block also copies it; the visible text is the
			// fallback when the clipboard is unavailable.
			document.querySelectorAll('.bibtex-toggle').forEach((toggle) => {
				toggle.addEventListener('click', async () => {
					const block = toggle.closest('article')?.querySelector('.bibtex');
					if (!block) return;
					const opening = block.classList.contains('hidden');
					block.classList.toggle('hidden', !opening);
					toggle.setAttribute('aria-expanded', String(opening));
					if (!opening) return;
					try {
						await navigator.clipboard.writeText(block.textContent);
						toggle.textContent = 'Copied ✓';
						setTimeout(() => { toggle.textContent = 'BibTeX'; }, 2000);
					} catch {
						// Clipboard blocked: the expanded block can be copied by hand.
					}
				});
			});
		}
		bind();
		document.addEventListener('astro:after-swap', bind);
	})();
</script>
