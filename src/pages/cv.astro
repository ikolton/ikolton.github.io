---
import Layout from "@/layouts/Layout.astro";
import { experiences, education, skills, awards } from "@/data/cv";
import { publications } from "@/data/publications";
import { profile } from "@/settings";
import { sortByEndDateDesc, sortByDateDesc, highlightAuthor } from "@/lib/utils";
import TimelineColumn from "@/components/ui/TimelineColumn.astro";
import SkillsGrid from "@/components/ui/SkillsGrid.astro";

const educationItems = sortByEndDateDesc(education).map((item) => ({
	time: item.time,
	title: item.degree,
	org: item.location ? `${item.school} · ${item.location}` : item.school,
	description: item.description,
}));

const experienceItems = sortByEndDateDesc(experiences).map((item) => ({
	time: item.time,
	title: item.title,
	org: item.location ? `${item.company} · ${item.location}` : item.company,
	description: item.description,
}));

const orderedAwards = sortByDateDesc(awards);
const orderedPublications = sortByDateDesc(publications);
---

<Layout title="CV">
	<div class="mx-auto max-w-4xl px-6 py-16">
		<p class="mb-3 font-mono text-xs uppercase tracking-widest text-accent dark:text-accent-dark">CV</p>
		<h1 class="mb-6 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">{profile.fullName}</h1>
		<p class="mb-16 max-w-2xl text-[15px] leading-relaxed text-neutral-600 dark:text-neutral-400">
			{profile.bio}
		</p>

		{(educationItems.length > 0 || experienceItems.length > 0) && (
			<section class="mb-16">
				<div class="flex flex-wrap gap-12">
					{educationItems.length > 0 && <TimelineColumn label="Education" items={educationItems} />}
					{experienceItems.length > 0 && <TimelineColumn label="Experience" items={experienceItems} />}
				</div>
			</section>
		)}

		{orderedAwards.length > 0 && (
			<section class="mb-16">
				<p class="mb-4 text-[13px] font-semibold text-neutral-500 dark:text-neutral-500">Grants & Awards</p>
				<div class="flex flex-col gap-4">
					{orderedAwards.map((award) => (
						<div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-900/40">
							<p class="text-[14.5px] leading-relaxed text-neutral-600 dark:text-neutral-400">
								<strong class="font-semibold text-neutral-900 dark:text-neutral-50">
									{award.link ? (
										<a href={award.link} target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark">
											{award.title}
										</a>
									) : (
										award.title
									)}
								</strong>
								{" "}({award.time}) — {award.issuer}
								{award.description && <>. {award.description}</>}
							</p>
						</div>
					))}
				</div>
			</section>
		)}

		{skills.length > 0 && (
			<section class="mb-16">
				<p class="mb-5 text-[13px] font-semibold text-neutral-500 dark:text-neutral-500">Skills</p>
				<SkillsGrid skills={skills} />
			</section>
		)}

		{orderedPublications.length > 0 && (
			<section>
				<p class="mb-5 text-[13px] font-semibold text-neutral-500 dark:text-neutral-500">Publications</p>
				<div class="flex flex-col gap-5">
					{orderedPublications.map((pub) => (
						<article class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-900/40">
							<h3 class="mb-2 text-base font-bold leading-snug">
								<a href={pub.link} target="_blank" rel="noopener noreferrer" class="text-neutral-900 no-underline dark:text-neutral-50">
									{pub.title}
								</a>
							</h3>
							<p class="mb-1.5 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
								<span set:html={highlightAuthor(pub.authors)} />
							</p>
							<p class="font-mono text-[11.5px] text-neutral-500 dark:text-neutral-500">{pub.journal} · {pub.time}</p>
						</article>
					))}
				</div>
			</section>
		)}
	</div>
</Layout>
