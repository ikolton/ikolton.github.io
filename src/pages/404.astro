---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="404 - Page Not Found">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center">
    <h1 class="text-9xl font-black text-neutral-900 dark:text-neutral-50 mb-4">404</h1>
    <h2 class="text-4xl font-bold text-neutral-900 dark:text-neutral-50 mb-8">Page Not Found</h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">
        Looks like this page went on a coffee break. ☕<br/>
        Even our smartest algorithms couldn't find it!
      </p>
    <div class="flex gap-4">
      <a
        href="/"
        class="rounded-md border border-neutral-200 px-5 py-2.5 text-sm font-medium text-neutral-700 hover:border-emerald-400 hover:text-emerald-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-emerald-500 dark:hover:text-emerald-300"
      >
        Go Home
      </a>
      <button
        class="rounded-md border border-neutral-200 px-5 py-2.5 text-sm font-medium text-neutral-700 hover:border-emerald-400 hover:text-emerald-600 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-emerald-500 dark:hover:text-emerald-300"
        onclick="history.back()"
      >
        Go Back
      </button>
    </div>
  </div>
</Layout>
