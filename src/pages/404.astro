---
import Layout from '@/layouts/Layout.astro'
import { profile, template } from '@/settings'
---

<Layout title={`Page not found · ${profile.fullName}`}>
	<section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-6 py-24 text-center">
		<p class="mb-3 font-mono text-xs uppercase tracking-widest text-accent dark:text-accent-dark">404</p>
		<h1 class="mb-4 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-50">Page not found</h1>
		<p class="mb-8 text-[15px] leading-relaxed text-neutral-600 dark:text-neutral-400">
			This page doesn't exist or has moved.
		</p>
		<div class="flex flex-wrap justify-center gap-3">
			<a href={`${template.base}/`} class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white no-underline dark:bg-accent-dark dark:text-neutral-950">
				Go to homepage
			</a>
			<a href={`${template.base}/cv`} class="rounded-lg border border-neutral-300 px-5 py-2.5 text-sm font-medium text-neutral-900 no-underline dark:border-neutral-700 dark:text-neutral-50">
				View CV
			</a>
		</div>
	</section>
</Layout>
