---
import Layout from '@/layouts/Layout.astro'

import { profile } from '@/settings'
import { publications } from '@/data/publications'
import { sortByDateDesc } from '@/lib/utils'
import ProfilePictures from '@/assets/profile_pictures.jpg'
import Hero from '@/components/ui/Hero.astro'
import ResearchSection from '@/components/ui/ResearchSection.astro'
import PublicationsSection from '@/components/ui/PublicationsSection.astro'
import BackgroundSection from '@/components/ui/BackgroundSection.astro'
import ContactSection from '@/components/ui/ContactSection.astro'

const { fullName, title, secondaryTitle, institute, bio, research_areas } = profile
const orderedPublications = sortByDateDesc(publications)
---

<Layout>
	<Hero fullName={fullName} title={title} secondaryTitle={secondaryTitle} institute={institute} bio={bio} profilePicture={ProfilePictures} />
	<ResearchSection areas={research_areas} />
	<PublicationsSection publications={orderedPublications} />
	<BackgroundSection />
	<ContactSection />
</Layout>
